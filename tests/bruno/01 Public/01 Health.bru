meta {
  name: Health
  type: http
  seq: 1
  tags: [
    smoke
    public
  ]
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("health is public and returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("health response follows the contract", function () {
    const body = res.getBody();
    expect(body.status).to.equal("ok");
    expect(body.version).to.match(/^\d+\.\d+\.\d+$/);
    expect(body.uptimeSeconds).to.be.a("number");
    expect(body.uptimeSeconds).to.be.at.least(0);
  });
}
