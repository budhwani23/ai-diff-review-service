meta {
  name: Invalid diff
  type: http
  seq: 2
  tags: [
    validation
  ]
}

post {
  url: {{baseUrl}}/v1/reviews
  body: json
  auth: bearer
}
auth:bearer {
  token: {{bearerToken}}
}
body:json {
  { "diff": "hello world" }
}

tests {
  test("non-unified diff returns 422 invalid_diff", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("invalid_diff");
  });
}
