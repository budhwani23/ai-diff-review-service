meta {
  name: Empty diff
  type: http
  seq: 3
  tags: [
    validation
  ]
}
post {
  url: {{baseUrl}}/v1/reviews
  body: json
  auth: bearer
}
auth:bearer {
  token: {{bearerToken}}
}
body:json {
  { "diff": "" }
}

tests {
  test("empty diff returns 422 invalid_diff", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("invalid_diff");
  });
}
