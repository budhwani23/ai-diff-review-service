  token: {{bearerToken}}
}
body:json {
  { "options": { "provider": "mock" } }
}

tests {
  test("missing diff returns 422 invalid_diff", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("invalid_diff");
  });
}
