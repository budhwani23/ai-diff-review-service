const requests = [];

for (let i = 0; i < 31; i++) {
  const request = send({
    method: "POST",
    url: baseUrl + "/v1/reviews",
    headers: {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json"
    },
    data: {
      diff:
        "--- a/src/rate-" + nonce + "-" + i + ".js\n" +
        "+++ b/src/rate-" + nonce + "-" + i + ".js\n" +
        "@@ -0,0 +1 @@\n" +
        "+console.log(" + i + ");\n",
      options: {
        provider: "mock",
        maxFindings: 100
      }
    },
    timeout: 30000
  })
  .then((response) => ({
    status: response.status,
    data: response.data,
    headers: response.headers
  }))
  .catch((error) => ({
    status:
      error.response && error.response.status
        ? error.response.status
        : null,

    data:
      error.response
        ? error.response.data
        : null,

    headers:
      error.response
        ? error.response.headers
        : {},

    requestError:
      error.message || String(error)
  }));

  requests.push(request);
}

const responses = await Promise.all(requests);