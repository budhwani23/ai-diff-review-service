meta {
  name: Submit two chunk file-boundary diff
  type: http
  seq: 1
  tags: [
    chunking
  ]
}
post {
  url: {{baseUrl}}/v1/reviews
  body: json
  auth: bearer
}
auth:bearer {
  token: {{bearerToken}}
}
body:json {
  { "diff": "placeholder", "options": { "provider": "mock", "maxFindings": 100 } }
}
script:pre-request {
  const padding = "x".repeat(39000);
  const diff =
    "diff --git a/z.ts b/z.ts\n--- a/z.ts\n+++ b/z.ts\n@@ -0,0 +1,2 @@\n" +
    "+const padding = \"" + padding + "\";\n" +
    "+console.log(\"z\");\n" +
    "diff --git a/a.ts b/a.ts\n--- a/a.ts\n+++ b/a.ts\n@@ -0,0 +1,2 @@\n" +
    "+const padding = \"" + padding + "\";\n" +
    "+console.log(\"a\");\n";
  req.setBody({ diff, options: { provider: "mock", maxFindings: 100 } });
}
script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("chunkJobId", res.getBody().jobId);
    bru.setVar("chunkPollAttempts", 0);
  }
}
tests {
  test("large multi-file diff is accepted", function () { expect(res.getStatus()).to.equal(202); });
}
