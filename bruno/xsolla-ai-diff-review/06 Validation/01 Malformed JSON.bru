meta {
  name: Malformed JSON
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/reviews
  body: text
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Content-Type: text/plain
}

body:text {
  this is deliberately not JSON
}

tests {
  test("uses the invalid_json error envelope", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal("invalid_json");
  });
}
