meta {
  name: Poll cached review
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/reviews/{{cacheJobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

tests {
  test("cached job eventually reports a cache hit", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    if (body.status !== "done") return;
    expect(body.usage.cacheHit).to.equal(true);
  });
}
