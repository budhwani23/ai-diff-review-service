meta {
  name: Wrong token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/reviews/does-not-matter
  body: none
  auth: bearer
}

auth:bearer {
  token: deliberately-wrong-token
}

tests {
  test("rejects an incorrect bearer token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("unauthorized");
  });
}
